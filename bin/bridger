#!/usr/bin/env bash
# bridger — file-based message bus between Claude Code sessions.
#
# Layout under $BRIDGER_ROOT (default ~/.claude/bridger):
#   peers/<name>.json        peer registration: {name, cwd, repo, branch, ...}
#   peers/<name>.beat        rewritten by the watcher each cycle, holds its pid;
#                            fresh mtime + live pid = "listening"
#   threads/<a>--<b>/        one directory per peer pair, names sorted
#     00001.json ...         immutable messages, zero-padded sequence number
#     cursor-<name>          highest seq <name> has consumed
#
# Invariants:
#   - Messages are never modified after creation. Each reader tracks its
#     position with a cursor file, so every thread doubles as an audit log.
#   - A message lands via hard-link from a temp file: if two sessions race
#     for the same seq, one link fails and that writer retries with the
#     next seq. No locks needed for the two-writers-per-thread case.
#   - Peer names must not contain "--" so "<a>--<b>" directory names stay
#     unambiguous.
#   - A name is a durable address: a message sent to a closed session is still
#     addressed correctly when it starts again. Liveness is a separate, soft
#     signal (the heartbeat).
#   - Identity is per session, not per directory: two sessions working one
#     directory (say two Claude Code sessions on the same branch) register
#     distinct names and each resolves to its own. A session is recognised by
#     its Claude Code session id and only ever resolves to the peer it itself
#     registered — a name left in a directory by an earlier session is never
#     inherited; reclaiming it is a deliberate `register <name>` (a dead holder
#     is reclaimable, queued messages intact). Only an id-less caller (a plain
#     shell, a script) falls back to the directory match, and it never rebinds.
#     A name is held by one live session at a time.
set -euo pipefail

# The plugin's own directory, so the wiring command can copy the shipped badge
# and dispatcher out to a stable location that survives plugin updates.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Claude Code config dir + the statusline wiring under it. The badge is a
# "fragment" dropped into statusline.d/, which a dispatcher (the user's
# statusLine command points at it) runs alongside every other fragment — a
# drop-in dir so tools that each want a badge never fight over Claude Code's
# single statusLine slot.
CLAUDE_CFG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
STATUSLINE_D="$CLAUDE_CFG_DIR/statusline.d"
STATUSLINE_BADGE="$CLAUDE_CFG_DIR/hooks/bridger-statusline.sh"
STATUSLINE_FRAGMENT="$STATUSLINE_D/50-bridger.sh"
STATUSLINE_DISPATCH="$CLAUDE_CFG_DIR/hooks/statusline-dispatch.sh"
SETTINGS_FILE="$CLAUDE_CFG_DIR/settings.json"

die() { echo "bridger: $*" >&2; exit 1; }

# `${VAR:-default}` treats set-but-empty exactly like unset. For the one variable
# that selects WHICH BUS we read and write, that is the wrong reading: a caller
# who passed an explicit empty string gets silently pointed at the user's real
# ~/.claude/bridger, where other live sessions keep their mail. A wrapper doing
# `BRIDGER_ROOT="$SOMEVAR" bridger register x` with SOMEVAR empty then registers
# a peer, and writes a statusline badge, into a bus it never meant to touch.
# Unset is fine — that IS how you ask for the default. Empty is a caller bug.
# Checked BEFORE the fallback below, which would otherwise have already turned
# the empty string into the default and left nothing to detect.
[ -z "${BRIDGER_ROOT+x}" ] || [ -n "$BRIDGER_ROOT" ] \
  || die "BRIDGER_ROOT is set but empty — refusing to fall back to $HOME/.claude/bridger (unset it to use the default)"

BRIDGER_ROOT="${BRIDGER_ROOT:-$HOME/.claude/bridger}"

# Suggest the install command that fits the machine's package manager, so a
# user missing jq gets a line they can paste rather than a bare URL.
jq_install_hint() {
  if command -v brew >/dev/null 2>&1; then echo "brew install jq"
  elif command -v apt >/dev/null 2>&1; then echo "sudo apt install jq"
  elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install jq"
  elif command -v pacman >/dev/null 2>&1; then echo "sudo pacman -S jq"
  elif command -v apk >/dev/null 2>&1; then echo "sudo apk add jq"
  else echo "see https://jqlang.github.io/jq/download/"
  fi
}

command -v jq >/dev/null 2>&1 || die "jq is required — install it: $(jq_install_hint)"

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

valid_name() {
  case "$1" in
    *--*) return 1 ;;
    # A name goes straight into peer_file()/beat_file()/thread_dir() as PATH, so
    # this check is the only thing keeping state inside BRIDGER_ROOT. `grep` alone
    # could not carry that: it is LINE-oriented and -q succeeds when ANY line
    # matches, so a name with an embedded newline passed on one of its lines and
    # the rest became directory — `register $'../../../x\ny'` wrote a peer record
    # into any directory the user can write to. Match the whole string here, in
    # the shell, where there are no lines. grep still runs below as the
    # authoritative charset/length check (its ranges are locale-correct); this arm
    # only ever rejects, so it can never widen what is accepted.
    ''|*[!a-z0-9-]*|[!a-z0-9]*) return 1 ;;
    *) printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,31}$' ;;
  esac
}

peer_file() { echo "$BRIDGER_ROOT/peers/$1.json"; }
beat_file() { echo "$BRIDGER_ROOT/peers/$1.beat"; }

# The directory a peer registered. FAILS unless the record yields an actual
# string path — unreadable, absent, null, or a hand-written list/number all
# answer "no path here". None of those are evidence that a directory is GONE,
# and `reap --force` deletes registrations on that answer.
peer_cwd() { jq -er 'if (.cwd | type) == "string" then .cwd else empty end' "$(peer_file "$1")" 2>/dev/null; }

# Absence is only evidence when we could actually look. `[ ! -d ]` is also false
# when a parent turned untraversable (chmod, a revoked mount), and a session may
# be alive and reading inside — `reap --force` would strand its mail on a
# directory that is demonstrably there. Unlike `kill -0`, we CAN tell these
# apart, so "I cannot tell" must answer no, exactly as beat_pid_alive does.
dir_gone() { # path -> 0 only when its absence is provable
  local p="$1" parent
  [ -n "$p" ] || return 1
  if [ -e "$p" ]; then return 1; fi
  parent=$(dirname "$p")
  while [ ! -e "$parent" ] && [ "$parent" != "/" ] && [ "$parent" != "." ]; do
    parent=$(dirname "$parent")
  done
  [ -x "$parent" ]
}

# Directories that asked to stay out. One absolute path per line, so you can
# read and edit the list with any tool. `bridger leave` adds, `join` removes.
optout_file() { echo "$BRIDGER_ROOT/optout"; }

opted_out() { # dir
  [ -f "$(optout_file)" ] && grep -qxF "$1" "$(optout_file)"
}

optout_add() { # dir
  mkdir -p "$BRIDGER_ROOT"
  opted_out "$1" || echo "$1" >> "$(optout_file)"
}

optout_remove() { # dir
  local f tmp
  f=$(optout_file)
  [ -f "$f" ] || return 0
  # Unique temp name, like write_peer and a message send — a FIXED "<file>.tmp"
  # is shared by every concurrent writer. The winner renames it away and each
  # loser's `mv` then fails with ENOENT; because that mv was the LAST command of
  # this function, it is the one shape where bash 3.2's errexit fires in the
  # CALLER, so `register` died here, before write_peer, and the session never
  # joined the bus at all. Measured on a bus that had ever seen one `leave`
  # (which is what creates this file): 8 concurrent registers, 64% lost.
  tmp=$(mktemp "$f.XXXXXX") || return 0
  grep -vxF "$1" "$f" > "$tmp" || true
  # Failing to rewrite an advisory list must not abort a registration. Losing a
  # removal is safe — the directory stays opted out and the next register or
  # join takes it out again — where losing the registration is not.
  mv "$tmp" "$f" || rm -f "$tmp"
  return 0
}

# A peer is "listening" while its watcher keeps the heartbeat fresh AND its
# process is alive. A closed session is "queued": messages still land, they are
# just read when it comes back. A peer whose registered directory no longer
# exists is additionally flagged "missing" — a housekeeping hint, not a verdict;
# see peer_status.
BEAT_STALE_SECS=15

file_age_secs() { # path -> seconds since mtime, or a large number if absent
  local f="$1" mtime
  [ -e "$f" ] || { echo 999999; return; }
  # BSD (macOS) and GNU stat disagree on flags; try both. GNU first: BSD stat
  # rejects -c with nothing on stdout, while GNU stat reads `-f %m` as
  # "filesystem status of a file named %m" and prints a block before failing.
  mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)
  echo $(( $(date +%s) - mtime ))
}

# The watcher has no self-termination path, so every death is external — and a
# dead watcher looks exactly like a quiet channel. Record how it ended (one
# tab-separated line: when, who, what) so the next one is diagnosable instead of
# mysterious. Diagnostic only: an auto-restart here would hide the same class of
# fault the "queued" badge exists to expose.
watcher_log() { # name event
  printf '%s\t%s\t%s\n' "$(now_utc)" "$1" "$2" >> "$BRIDGER_ROOT/watcher.log" 2>/dev/null || true
}

# The beat file holds the watcher's pid, so a death is seen the moment it
# happens instead of at the end of the staleness window — and `kill -0` is the
# only signal that separates "watcher is gone" from "machine was too busy to
# beat for 15s". An empty beat is a pre-0.12 watcher: mtime is all it left.
watcher_alive() { # beat path -> 0 when the recorded pid still runs
  local pid=""
  [ -f "$1" ] && { read -r pid < "$1" || true; }
  case "$pid" in
    ''|*[!0-9]*) return 0 ;;
    *) kill -0 "$pid" 2>/dev/null ;;
  esac
}

# Is a watcher process provably running for this peer? Differs from
# watcher_alive in what it does with "cannot tell": watcher_alive assumes alive
# (it only refines a beat that is already fresh), while this answers NO, because
# it decides whether an address is DEAD. Assuming a reader that isn't there
# would keep a deleted worktree's registration alive forever.
beat_pid_alive() { # beat path -> 0 only when it names a pid that still runs
  local pid=""
  [ -f "$1" ] || return 1
  read -r pid < "$1" || true
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
    *) kill -0 "$pid" 2>/dev/null ;;
  esac
}

peer_status() { # name -> listening | queued | missing
  local b cwd
  b=$(beat_file "$1")
  if [ "$(file_age_secs "$b")" -lt "$BEAT_STALE_SECS" ] && watcher_alive "$b"; then
    echo listening
    return
  fi
  # "missing" reports ONE fact: the registered directory no longer exists, and
  # no watcher process is running for the name. It is a housekeeping hint for
  # `reap`, never a reachability verdict, and nothing routes on it.
  #
  # It cannot be a verdict, because the peer may still be a live session. A
  # process keeps its cwd — and $PWD, which is what resolve_identity actually
  # compares — when its directory is unlinked, so a session whose worktree was
  # removed goes on resolving its name and polling and sending normally. If it
  # armed a watcher it reads as "listening" above; if it never armed one (which
  # this bus treats as ordinary — see the note under `peers`) there is NO signal
  # that separates it from a session that closed for good. Treating that guess
  # as truth is how a broadcast silently skips a session that is reading it.
  #
  # An unreadable record is NOT "missing" — see peer_cwd. A crash between
  # mktemp and mv leaves a 0-byte record for a peer whose directory is fine.
  if cwd=$(peer_cwd "$1") && dir_gone "$cwd" && ! beat_pid_alive "$b"; then
    echo missing
    return
  fi
  echo queued
}

# Repo identity for scoping: the shared git dir groups worktrees of one repo
# together (a worktree and its main checkout count as the same repo).
repo_id() { # dir -> path or empty
  (cd "$1" 2>/dev/null && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || true
}

git_branch() {
  (cd "$1" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null) || true
}

# Turn a directory into a usable peer name: "my-app" from /code/my-app.
name_from_dir() {
  local base
  base=$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' \
         | sed -e 's/-\{2,\}/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-32)
  [ -n "$base" ] || base=session
  echo "$base"
}

# Four hex chars. Reads a fixed two bytes: an unbounded /dev/urandom pipe
# would end in SIGPIPE under pipefail when the consumer stops first.
short_id() {
  od -An -N2 -tx1 /dev/urandom | tr -d ' \n'
}

require_peer() {
  [ -f "$(peer_file "$1")" ] || die "unknown peer '$1' (register it first)"
}

# Pair directory is order-independent: thread_dir a b == thread_dir b a.
thread_dir() {
  if [ "$1" \< "$2" ]; then echo "$BRIDGER_ROOT/threads/$1--$2"
  else echo "$BRIDGER_ROOT/threads/$2--$1"; fi
}

max_seq() {
  local dir="$1" max=0 f s stem
  for f in "$dir"/[0-9]*.json; do
    [ -e "$f" ] || continue
    # The glob only anchors the FIRST character, so `00001 2.json` (a Finder
    # duplicate), `0009-2.json` or `00006x.json` all reach here — and `$((10#…))`
    # on those is a fatal bash arithmetic error under set -e. max_seq is on the
    # read AND the write path, so one such file wedged the whole thread in both
    # directions: poll and send both died, and because the delivery hooks do
    # `peers || exit 0` the failure was silent. Skip what is not a number; a
    # stray file is not a message.
    stem=$(basename "$f" .json)
    case "$stem" in ''|*[!0-9]*) continue ;; esac
    s=$((10#$stem))
    [ "$s" -gt "$max" ] && max=$s
  done
  echo "$max"
}

# Print unread messages addressed to $2 in thread $1, one compact JSON per
# line, considering only seqs up to $3. The caller snapshots that bound with
# max_seq ONCE and reuses it for advance_cursor: scanning and cursor-writing
# from two different instants would let a message that lands in between be
# marked read without ever being delivered.
unread_in_thread() {
  local dir="$1" me="$2" top="$3" cur=0 f s rc stem
  [ -f "$dir/cursor-$me" ] && cur=$(cat "$dir/cursor-$me")
  # A cursor read as empty or junk must mean "read nothing yet", never "read
  # everything": advance_cursor truncates before writing, so a concurrent reader
  # can catch it empty, and `[ "$s" -gt "" ]` would then skip every message and
  # still move the cursor to the top — silent, permanent, unrecoverable loss.
  case "$cur" in ''|*[!0-9]*) cur=0 ;; esac
  for f in "$dir"/[0-9]*.json; do
    [ -e "$f" ] || continue
    stem=$(basename "$f" .json)
    case "$stem" in ''|*[!0-9]*) continue ;; esac   # see max_seq: not a message
    s=$((10#$stem))
    [ "$s" -gt "$cur" ] && [ "$s" -le "$top" ] || continue
    # A zero-byte message reads as "no output, exit 0" — indistinguishable, to
    # the select below, from a perfectly good message addressed to someone else.
    # So poll consumed it as nothing and moved the cursor past it, silently.
    # Size is free to check and catches the case that actually happens (a
    # truncated write, a half-synced or restored bus).
    if [ ! -s "$f" ]; then
      echo "bridger: message $f is empty — skipped" >&2
      continue
    fi
    rc=0
    # `error()` on a non-object makes jq exit 5, so a bare null/array/string
    # lands in the same loud skip as a parse error instead of vanishing.
    jq -c --arg me "$me" 'if type == "object" then select(.to == $me) else error("not a message object") end' "$f" 2>/dev/null || rc=$?
    if [ "$rc" -ne 0 ]; then
      # jq exits 5 ONLY for a parse error: bytes that will never improve, so
      # skipping is the one way past a message that would otherwise wedge this
      # thread forever — poll would die before advance_cursor and the reader
      # would replay the same prefix for good.
      #
      # Every other failure (2 = cannot open: EACCES, a revoked mount, EIO) is
      # transient. The message is intact and reads fine next time, so we must
      # NOT skip it: advance_cursor would mark it delivered and destroy a
      # perfectly good message. Stop the scan here instead — it clears itself the
      # moment the file is readable again.
      #
      # Report the seq through a file rather than a variable or `die`. A variable
      # cannot come back: the render path runs this in a pipeline, so it is a
      # subshell. And `die` is `exit`, which on the ONE call shape that is not a
      # pipeline (`poll --json`, what `ask` drains through) killed the whole
      # process — every thread sorting after the faulty one was then never polled
      # at all. The caller needs the seq to know how far it may still advance.
      if [ "$rc" -ne 5 ]; then
        echo "bridger: cannot read $f — not advancing the cursor past it" >&2
        [ -z "${BRIDGER_WEDGE_FILE:-}" ] || echo "$s" > "$BRIDGER_WEDGE_FILE"
        return 1
      fi
      echo "bridger: message $f is unparseable — skipped" >&2
    fi
  done
}

advance_cursor() { # thread_dir me top
  if [ "$3" -gt 0 ]; then echo "$3" > "$1/cursor-$2"; fi
}

# Is this message file safe to render? For the history readers (`log`, `mirror`)
# — poll has its own variant above, because only poll also has a cursor to move.
#
# One `jq -e` separates every case that matters, by exit status:
#   0  a JSON object                      -> render it
#   1  parsed, but not an object          -> corrupt (a bare null/array/string)
#   4  no output at all                   -> corrupt (zero-byte, NUL, whitespace)
#   5  parse error                        -> corrupt
#   2  cannot open: EACCES, revoked mount, EIO
#
# 4 is the case worth spelling out: jq exits 0 there, so every field reads back
# as the empty string and a renderer that trusts it prints a section with a blank
# seq, type and timestamp — a phantom entry, exit 0, nothing on stderr, inside a
# record `mirror` invites you to commit.
#
# 2 is deliberately NOT skipped. It is transient: the message is intact and reads
# fine next time. These readers render history someone keeps, so a wrong "corrupt"
# verdict burns a permanent hole into a file that looks complete — the same trade
# unread_in_thread makes, for the same reason.
message_renderable() { # file
  local rc=0
  jq -e 'type == "object"' "$1" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) return 0 ;;
    1|4|5) echo "bridger: message $1 is unreadable — skipped" >&2; return 1 ;;
    *) die "cannot read $1 — refusing to render a record that would look complete" ;;
  esac
}

# List every peer name except $1 (candidates for threads involving $1).
other_peers() {
  local f n
  for f in "$BRIDGER_ROOT"/peers/*.json; do
    [ -e "$f" ] || continue
    n=$(basename "$f" .json)
    [ "$n" = "$1" ] || echo "$n"
  done
}

# The thread directories a name takes part in. Walks threads/, never the peer
# registry: a thread outlives its partner's registration — `leave` and `reap`
# both keep it — so enumerating threads through other_peers would miss exactly
# the mail a departed correspondent stranded here.
peer_threads() { # name -> one thread dir per line
  local dir
  for dir in "$BRIDGER_ROOT"/threads/*"$1"*; do
    [ -d "$dir" ] || continue
    case "$(basename "$dir")" in "$1--"*|*"--$1") ;; *) continue ;; esac
    echo "$dir"
  done
}

# How many messages are waiting for $1 across every thread it takes part in —
# the backlog a name carries, whether or not anything is reading for it.
# Suffixed "+" when a message could not be read, so the number is a floor rather
# than a silent undercount. `reap` tells the operator to decide on this figure
# before dropping a registration, and an unreadable message would otherwise make
# a peer holding mail look emptier than it is.
unread_total() { # name -> count, or "N+" when the count is incomplete
  local name="$1" n=0 dir out partial=""
  while IFS= read -r dir; do
    out=$(unread_in_thread "$dir" "$name" "$(max_seq "$dir")" 2>/dev/null) || partial="+"
    n=$(( n + $(printf '%s' "$out" | grep -c . || true) ))
  done < <(peer_threads "$name")
  printf '%s%s\n' "$n" "$partial"
}

# The Claude Code session id — present in every tool call and stable across a
# session (CLAUDE_CODE_SESSION_ID). The session-start hook also exports it as
# BRIDGER_SESSION_ID; that explicit value wins so a hook or test can pin one.
# Empty outside a session (a plain shell, a script). Two sessions can share a
# working directory, so this is what tells them apart.
session_id() { echo "${BRIDGER_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}"; }

# Per-session statusline state: one file per session id holding the registered
# name. The badge script reads it on every render tick, so registration state
# IS badge state — register writes it (badge appears next tick), leave deletes
# it (badge vanishes next tick), with no statusLine rewrite in between. Keyed
# by the Claude Code session id, which the badge also reads from its stdin JSON;
# charset-limited before it becomes a filename, exactly as the badge does.
statusline_state_file() { # session_id -> path (empty if id unusable)
  local sid="$1"
  [ -n "$sid" ] || return 0
  case "$sid" in *[!A-Za-z0-9._-]*) return 0 ;; esac
  echo "$BRIDGER_ROOT/statusline/$sid"
}

statusline_write() { # name — record THIS session's registered name for the badge
  local f
  f=$(statusline_state_file "$(session_id)") || return 0
  [ -n "$f" ] || return 0
  mkdir -p "$(dirname "$f")"
  printf '%s' "$1" > "$f"
  statusline_autowire   # registering is the trigger: light the badge in THIS session
}

statusline_clear() { # drop THIS session's badge state
  local f
  f=$(statusline_state_file "$(session_id)") || return 0
  [ -n "$f" ] && rm -f "$f"
  return 0   # a no-op (no session id) must not report failure to a set -e caller
}

# Resolve identity from the working directory: the registered peer whose cwd
# equals $PWD or is its closest ancestor. Callers that need to resolve a
# DIFFERENT directory prefix the call with PWD=<dir> — an env-var prefix applies
# to shell functions just as it does to external commands.
#
# Identity is per SESSION, never inherited from a directory's history. A caller
# that carries a session id (every call inside a Claude Code session does) is
# ONLY ever the peer that same session registered — it never adopts a name an
# earlier session left in this directory, even one that is now dormant. That is
# what stops a fresh session from silently becoming "arch" just because "arch"
# was registered here once; to take that name it must `register arch` on purpose
# (a dead holder is reclaimable), which also recovers the messages queued to it.
# A caller WITHOUT a session id (a plain-shell CLI query, a script) is not a
# competing identity and never rebinds a peer, so it keeps the old convenience:
# the longest-cwd directory match.
resolve_identity() {
  local f name cwd sess sid best="" bestlen=-1 mine="" minelen=-1
  sid=$(session_id)
  for f in "$BRIDGER_ROOT"/peers/*.json; do
    [ -e "$f" ] || continue
    # The filename is the address, and an unreadable record resolves to nothing
    # — skip it quietly rather than leaking three raw jq errors per record on
    # every single command.
    name=$(basename "$f" .json)
    cwd=$(jq -er 'if (.cwd | type) == "string" then .cwd else empty end' "$f" 2>/dev/null) || continue
    sess=$(jq -r '.session // ""' "$f" 2>/dev/null || echo "")
    case "$PWD" in
      "$cwd"|"$cwd"/*)
        if [ "${#cwd}" -gt "$bestlen" ]; then best=$name; bestlen=${#cwd}; fi
        if [ -n "$sid" ] && [ "$sess" = "$sid" ] && [ "${#cwd}" -gt "$minelen" ]; then
          mine=$name; minelen=${#cwd}
        fi ;;
    esac
  done
  if [ -n "$sid" ]; then
    [ -n "$mine" ] && echo "$mine"
  else
    [ -n "$best" ] && echo "$best"
  fi
}

# The peer THIS session registered whose directory covers $PWD, or empty. Lets
# register find a session's own prior identity for a clean rename, without
# matching peers OTHER sessions registered in the same directory.
resolve_my_identity() {
  local f name cwd sess sid best="" bestlen=-1
  sid=$(session_id)
  [ -n "$sid" ] || return 0
  for f in "$BRIDGER_ROOT"/peers/*.json; do
    [ -e "$f" ] || continue
    sess=$(jq -r '.session // ""' "$f" 2>/dev/null || echo "")
    [ "$sess" = "$sid" ] || continue
    name=$(basename "$f" .json)
    cwd=$(jq -er 'if (.cwd | type) == "string" then .cwd else empty end' "$f" 2>/dev/null) || continue
    case "$PWD" in
      "$cwd"|"$cwd"/*)
        if [ "${#cwd}" -gt "$bestlen" ]; then best=$name; bestlen=${#cwd}; fi ;;
    esac
  done
  [ -n "$best" ] && echo "$best"
}

require_identity() {
  local me
  me=$(resolve_identity) || true
  [ -n "${me:-}" ] || die "this directory is not registered as a peer (run: bridger register <name>)"
  echo "$me"
}

# Write (or refresh) a peer record. Preserves the summary of an existing peer,
# since re-registering the same directory must not erase what it said it does.
# BRIDGER_SESSION_ID, when set (the session-start hook exports it), records
# which Claude Code session currently answers to this name — the session id is
# also the transcript filename, so a peer can be traced back to its session.
write_peer() { # name dir
  local name="$1" dir="$2" summary="" created session="${BRIDGER_SESSION_ID:-}"
  created=$(now_utc)
  if [ -f "$(peer_file "$name")" ]; then
    summary=$(jq -r '.summary // ""' "$(peer_file "$name")")
    created=$(jq -r '.created // empty' "$(peer_file "$name")")
    # Inherit the recorded session id ONLY while the directory is unchanged. A
    # record whose cwd is being rewritten is being handed to a different
    # session, and keeping the old id there made the new record claim to BE the
    # previous holder — so the peer read as live and held, by a session that no
    # longer had anything to do with it.
    [ -n "$session" ] \
      || [ "$(jq -r '.cwd // ""' "$(peer_file "$name")")" != "$dir" ] \
      || session=$(jq -r '.session // ""' "$(peer_file "$name")")
    [ -n "$created" ] || created=$(now_utc)
  fi
  mkdir -p "$BRIDGER_ROOT/peers"
  # Written to a temp file and moved into place. A plain `>` truncates first, so
  # a concurrent reader can see an empty record — and an empty record has no
  # cwd, which peer_status weighs when deciding "missing". A live peer must never
  # drop out of a listing because someone else re-registered at that instant.
  #
  # The temp name is unique per writer, via mktemp, exactly as a send does for a
  # message. A FIXED "<name>.json.tmp" would be shared by two concurrent writers
  # of one peer (register racing register, or register racing summary): both
  # truncate and interleave into the same inode, then one mv commits the
  # resulting garbage permanently and the other fails outright. That is strictly
  # worse than the `>` this replaced, whose corruption was at least transient.
  # It cannot collide with the peers/*.json glob — the suffix comes after .json.
  local tmp
  tmp=$(mktemp "$(peer_file "$name").XXXXXX")
  jq -n --arg name "$name" --arg cwd "$dir" --arg created "$created" \
        --arg repo "$(repo_id "$dir")" --arg branch "$(git_branch "$dir")" \
        --arg summary "$summary" --arg seen "$(now_utc)" --arg session "$session" \
    '{name: $name, cwd: $cwd, repo: $repo, branch: $branch,
      summary: $summary, session: $session, created: $created, last_seen: $seen}' \
    > "$tmp"
  mv "$tmp" "$(peer_file "$name")"
}

# Does this peer have any message history? Renaming away from a name with a
# thread would orphan that thread, so it is only safe when there is none.
peer_has_history() { # name
  local dir f
  while IFS= read -r dir; do
    for f in "$dir"/[0-9]*.json; do [ -e "$f" ] && return 0; done
  done < <(peer_threads "$1")
  return 1
}

cmd_register() {
  local name="${1:-}" dir="${2:-$PWD}" sid mine existing holder prev status
  [ -n "$name" ] || die "usage: bridger register <name> [dir]"
  valid_name "$name" || die "invalid name '$name' (lowercase letters, digits, single dashes; max 32 chars)"
  [ -d "$dir" ] || die "no such directory: $dir"
  dir=$(cd "$dir" && pwd)
  sid=$(session_id)

  # DECIDE BEFORE DESTROYING. Both refusals below used to sit AFTER the two
  # `rm -f` blocks, so a register that was about to be refused had already
  # deleted the caller's own registration: the session was left with no identity
  # at all, its old name gone from the bus, and everyone who knew it by that name
  # got "unknown peer". Nothing here writes; it only decides.
  if [ -f "$(peer_file "$name")" ]; then
    holder=$(jq -r '.session // ""' "$(peer_file "$name")")
    status=$(peer_status "$name")

    # Same name, a DIFFERENT session, still live: refuse rather than let two
    # sessions share one mailbox (they would race on the same read cursor). A
    # dead holder (stale heartbeat) is taken over — how a restart reclaims a
    # role. There is deliberately no `[ -n "$sid" ]` test: a caller with no
    # session id — a plain shell, a script, a cron job, any wrapper that does not
    # export one — is exactly the caller that must not be able to override a
    # watcher that is demonstrably running.
    if [ -n "$holder" ] && [ "$holder" != "$sid" ] && [ "$status" = "listening" ]; then
      die "'$name' is held by a live session — stop it or pick another name"
    fi

    # A name registered to ANOTHER directory is somebody else's address. Taking
    # it silently redirects every queued message and every future send to this
    # session, while the previous holder keeps its own $PWD, keeps working, and
    # simply never receives again — its summary is even inherited, so the
    # listing looks unchanged. `missing` is the one status that is real evidence
    # the old holder is gone (its directory is provably absent AND no watcher is
    # running for the name), which is what keeps reclaiming a deleted worktree
    # working; and a session may always rebind its own name.
    prev=$(peer_cwd "$name" || true)
    if [ -n "$prev" ] && [ "$prev" != "$dir" ] && [ "$status" != "missing" ] \
       && ! { [ -n "$sid" ] && [ "$holder" = "$sid" ]; }; then
      die "'$name' is registered to $prev — run 'bridger reap' there first, or pick another name"
    fi
  fi

  # A clean rename of MY OWN identity in this directory: drop the old name so a
  # session answers to exactly one. Refused when that name has a thread — its
  # log would be orphaned; keep it, or `bridger leave` first.
  mine=$(PWD="$dir" resolve_my_identity) || true
  if [ -n "${mine:-}" ] && [ "$mine" != "$name" ]; then
    if peer_has_history "$mine"; then
      die "you are '$mine', which has message history.
       Keep that name, or run 'bridger leave' first — its thread stays on disk as a log."
    fi
    rm -f "$(peer_file "$mine")" "$(beat_file "$mine")"
  fi

  # Upgrade a session-less derived name sitting on this exact directory (the
  # auto-register -> explicit-register path). A name another session owns, or
  # one with a thread, is left alone — two sessions may share a directory.
  existing=$(PWD="$dir" resolve_identity) || true
  if [ -n "${existing:-}" ] && [ "$existing" != "$name" ] \
     && [ "$(jq -r .cwd "$(peer_file "$existing")")" = "$dir" ] \
     && [ -z "$(jq -r '.session // ""' "$(peer_file "$existing")")" ] \
     && ! peer_has_history "$existing"; then
    rm -f "$(peer_file "$existing")" "$(beat_file "$existing")"
  fi

  optout_remove "$dir"   # naming a directory is an explicit opt-in
  BRIDGER_SESSION_ID="$sid" write_peer "$name" "$dir"   # claim it for this session
  statusline_write "$name"   # light the badge this tick, no statusLine rewrite
  echo "registered '$name' -> $dir"
}

# Stop being addressable from this directory. The peer record goes away, so
# nothing can be sent here and nothing is listed; existing threads stay on
# disk as history. Reverse it with `join` (or by naming it with `register`).
cmd_leave() {
  local me dir
  me=$(resolve_identity) || true
  if [ -z "${me:-}" ]; then
    optout_add "$PWD"
    echo "this directory was not a peer; it will not auto-register"
    return 0
  fi
  dir=$(jq -r .cwd "$(peer_file "$me")")
  rm -f "$(peer_file "$me")" "$(beat_file "$me")"
  statusline_clear   # unregistered → badge gone next tick
  optout_add "$dir"
  echo "left the bridger as '$me'; $dir will not auto-register (history kept)"
}

cmd_join() {
  local me
  optout_remove "$PWD"
  me=$(derive_and_register "$PWD")
  statusline_write "$me"
  echo "joined the bridger as '$me'"
}

# Register a directory under a name derived from it ("my-app" from
# /code/my-app). Idempotent: a directory that already has a peer keeps its
# name and mailbox. Shared by `join` and auto-discovery.
#
# Naming differs by how deliberate the act was. `join` is a human choice, so
# the name is the predictable basename (suffixed -2, -3 on collision). Auto-
# discovery names get a generated tag — "my-app-3f2a" — because a mesh full of
# bare basenames invites collisions and misdelivery. The tag is minted once
# per DIRECTORY and persisted, never per session: a per-session name would die
# with the session, and queued delivery needs an address that outlives it.
derive_and_register() { # dir [tagged]
  local dir="$1" existing base name n=2
  existing=$(PWD="$dir" resolve_identity) || true
  if [ -n "${existing:-}" ]; then
    # Refresh branch/last_seen — the identity itself stays put.
    write_peer "$existing" "$(jq -r .cwd "$(peer_file "$existing")")"
    echo "$existing"
    return 0
  fi
  base=$(name_from_dir "$dir")
  if [ "${2:-}" = "tagged" ]; then
    base=$(echo "$base" | cut -c1-27 | sed 's/-$//')
    while :; do
      name="$base-$(short_id)"
      [ -f "$(peer_file "$name")" ] || break
    done
  else
    name="$base"
    while [ -f "$(peer_file "$name")" ]; do
      name="$base-$n"
      n=$((n + 1))
    done
  fi
  # Bind the freshly minted name to the session that created it, so that session
  # resolves as its owner (not via a directory fallback) and no LATER session
  # inherits it. An id-less caller binds nothing — session stays empty.
  BRIDGER_SESSION_ID="$(session_id)" write_peer "$name" "$dir"
  echo "$name"
}

# Called by the session-start hook. The bridger is OPT-IN by default: a session
# only becomes addressable when its directory was explicitly registered (or
# joined). Set CLAUDE_BRIDGER_AUTO=1 to let every session join on its own —
# peers-style discovery for people who want a machine-wide mesh.
cmd_autoregister() {
  local dir="${1:-$PWD}" existing name
  dir=$(cd "$dir" && pwd)
  existing=$(PWD="$dir" resolve_identity) || true
  if [ -n "${existing:-}" ]; then
    write_peer "$existing" "$(jq -r .cwd "$(peer_file "$existing")")"
    statusline_write "$existing"
    echo "$existing"
    return 0
  fi
  [ "${CLAUDE_BRIDGER_AUTO:-0}" = "1" ] || exit 1
  opted_out "$dir" && exit 1
  name=$(derive_and_register "$dir" tagged)
  statusline_write "$name"
  echo "$name"
}

# Say what this session is working on, so other agents can pick the right peer.
cmd_summary() {
  local text="${*:-}" me tmp
  [ -n "$text" ] || die "usage: bridger summary <text>"
  me=$(require_identity)
  # Unique temp name, for the same reason write_peer uses one: a fixed
  # "<name>.json.tmp" is shared with a concurrent register of this peer, and the
  # loser of that race commits an interleaved record.
  tmp=$(mktemp "$(peer_file "$me").XXXXXX")
  jq --arg s "$text" '.summary = $s' "$(peer_file "$me")" > "$tmp"
  mv "$tmp" "$(peer_file "$me")"
  echo "summary set for '$me'"
}

# Who else is out there. Scope narrows the list; default is everything on this
# machine. Status is a soft signal — a "queued" peer still receives messages.
# The footer restates that inline: a reader who has only this output (not the
# help text) otherwise reads "queued" as "nobody home" and skips the ask.
cmd_peers() {
  local scope=machine me my_repo f name cwd repo branch summary status mark
  local queued_others=0 missing_any=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --machine|--repo|--dir) scope="${1#--}"; shift ;;
      *) die "usage: bridger peers [--machine|--repo|--dir]" ;;
    esac
  done
  me=$(resolve_identity) || true
  my_repo=$(repo_id "$PWD")
  for f in "$BRIDGER_ROOT"/peers/*.json; do
    [ -e "$f" ] || continue
    # The FILENAME is the address, not the .name field: peer_file/beat_file are
    # keyed by it, as other_peers and reap already are. A hand-edited record
    # whose .name disagrees would otherwise send peer_status looking up a peer
    # file that does not exist.
    #
    # An unreadable record is skipped, not fatal. jq exits 5 on one, which under
    # errexit would abort this loop: every peer sorting after it disappears from
    # the listing, and deliver.sh/stop.sh both do `peers || exit 0`, so one
    # truncated file would silence unread reports for every session on the box.
    name=$(basename "$f" .json)
    # A record we cannot read a path out of still names an addressable peer, so
    # it stays in the listing with an empty directory — hiding it would repeat
    # the bug this guard fixes. The guard is only that jq's exit 5 must not abort
    # the loop under errexit: that dropped every peer sorting after the bad file,
    # and deliver.sh/stop.sh both do `peers || exit 0`, so one truncated record
    # silenced unread reports for every session on the machine. The type check
    # keeps a list/number cwd from printing across three lines.
    cwd=$(jq -er 'if (.cwd | type) == "string" then .cwd else empty end' "$f" 2>/dev/null) \
      || { echo "bridger: peer '$name' has no readable directory in its record" >&2; cwd=""; }
    repo=$(jq -r '.repo // ""' "$f" 2>/dev/null || echo "")
    branch=$(jq -r '.branch // ""' "$f" 2>/dev/null || echo "")
    summary=$(jq -r '.summary // ""' "$f" 2>/dev/null || echo "")
    case "$scope" in
      repo) [ -n "$my_repo" ] && [ "$repo" = "$my_repo" ] || continue ;;
      dir)  [ "$cwd" = "$PWD" ] || continue ;;
    esac
    status=$(peer_status "$name")
    mark=""; [ "$name" = "${me:-}" ] && mark=" (you)"
    [ "$status" = queued ] && [ -z "$mark" ] && queued_others=1
    [ "$status" = missing ] && missing_any=1
    printf '%s [%s]%s %s%s%s\n' "$name" "$status" "$mark" "$cwd" \
      "$([ -n "$branch" ] && echo " @$branch")" \
      "$([ -n "$summary" ] && echo " — $summary")"
  done
  if [ "$queued_others" -eq 1 ]; then
    echo "note: [queued] means only that this peer's watcher is not running — it may be a live session that never armed one. It is still addressable and still receives. Reachability is proven by 'ask', never by this status."
  fi
  # Nothing points at reap otherwise, and "missing" reads as a harsher "queued"
  # unless the one thing it does NOT mean is said out loud.
  if [ "$missing_any" -eq 1 ]; then
    echo "note: [missing] adds two facts to [queued]: that peer's registered directory no longer exists, and no watcher process is running for the name. It is still addressable and still receives — it may be a live session reading from the removed path. Usually it is a leftover registration: 'bridger reap' lists them with what they still hold, 'bridger reap --force' drops them (threads kept)."
  fi
}

cmd_whoami() {
  local me
  me=$(resolve_identity) || true
  [ -n "${me:-}" ] || exit 1
  echo "$me"
}

# A send is fire-and-forget: it succeeds whether or not anything is reading at
# the other end, and the sender is told only the sequence number. That silence
# is how a session ends up monologuing — sending message after message to a
# peer that never armed a watch, with nothing to distinguish it from a peer
# that is listening and simply hasn't replied yet. Say so on the first send.
# stderr, so stdout stays the bare seq that callers (including the multi-
# recipient path below) parse.
warn_if_unheard() { # to from
  local to="$1" from="$2" dir n status
  status=$(peer_status "$to")
  [ "$status" = listening ] && return 0
  dir=$(thread_dir "$from" "$to")
  n=$(unread_in_thread "$dir" "$to" "$(max_seq "$dir")" | grep -c . || true)
  # Same promise as "queued" — it may well be read — plus the one extra fact a
  # sender can act on: this registration looks abandoned, so if nobody answers,
  # that is the likely reason. Deliberately not phrased as unreachable.
  if [ "$status" = missing ]; then
    echo "warning: '$to' is not listening, and its directory $(peer_cwd "$to") no longer exists — $n message(s) from you are unread. It may still be a live session reading from the removed path; if it is not, this is a leftover registration ('bridger reap' lists them)." >&2
    return 0
  fi
  echo "warning: '$to' is not listening — no watcher is running there, and $n message(s) from you are unread. It will read them on its next activity, not now. Sending more will not reach it any sooner." >&2
}

cmd_send() {
  local from="" to="" type="" body="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -ge 2 ] || die "--from needs a value"; from="$2"; shift 2 ;;
      --ref)  [ $# -ge 2 ] || die "--ref needs a value";  ref="$2";  shift 2 ;;
      *)
        if [ -z "$to" ]; then to="$1"
        elif [ -z "$type" ]; then type="$1"
        elif [ -z "$body" ]; then body="$1"
        else die "unexpected argument: $1"
        fi
        shift ;;
    esac
  done
  [ -n "$to" ] && [ -n "$type" ] && [ -n "$body" ] || die "usage: bridger send <to>[,<to>...]|@all <type> <body> [--ref N] [--from <name>]"
  # Validate here, not at the jq call: a bad --ref used to be discovered only
  # while building the message, AFTER mktemp — which on the fan-out path (where
  # errexit does not reach, see below) left a ZERO-BYTE file linked at a real
  # seq and still reported success. Nothing can read that message, and the
  # reader's cursor moves past it.
  case "$ref" in ''|*[!0-9]*) [ -z "$ref" ] || die "--ref must be a message number, got: $ref" ;; esac
  [ -n "$from" ] || from=$(require_identity)

  # Routing: "@all" fans out to every other peer; "a,b" to exactly those.
  # Each recipient gets the message in its own pairwise thread, so peers the
  # message doesn't concern never see it. Fan-out prints "<peer> <seq>" per
  # recipient; single sends keep printing the bare seq (ask relies on it).
  local recipients="" r
  if [ "$to" = "@all" ]; then
    # Every registered peer, with no liveness filtering. A peer whose directory
    # is missing may still be a live session reading from the unlinked path, and
    # nothing here can tell — skipping it would silently drop a recipient that
    # is listening. A queued copy costs a file; a missed broadcast costs a peer.
    recipients=$(other_peers "$from")
    [ -n "$recipients" ] || die "no other peers to broadcast to"
  elif [ "${to#*,}" != "$to" ]; then
    case ",$to," in *",@all,"*) die "cannot mix @all with a peer list" ;; esac
    recipients=$(echo "$to" | tr ',' '\n')
  fi
  if [ -n "$recipients" ]; then
    # Read the list, never word-split it: `for r in $recipients` also GLOBS, so
    # `send "x,*"` expanded against $PWD and delivered to whatever files happened
    # to be named there — recipients the caller never addressed.
    local seq_out rc_any=0
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      # Capture the status per recipient. `echo "$r $(cmd_send ...)"` discarded
      # it — echo succeeds, so a partial (or total) fan-out failure exited 0 and
      # no caller could tell. errexit does not propagate into $( ) on bash 3.2,
      # so nothing else was catching it either.
      if seq_out=$(cmd_send "$r" "$type" "$body" --from "$from" ${ref:+--ref "$ref"}); then
        echo "$r $seq_out"
      else
        rc_any=1
        echo "$r FAILED"
      fi
    done <<EOF
$recipients
EOF
    return "$rc_any"
  fi

  # A name becomes a PATH in thread_dir, and require_peer only tests that some
  # <name>.json exists — which `../../elsewhere/package` satisfies. Without this,
  # `send ../../victim/pwn` wrote a message file outside BRIDGER_ROOT entirely,
  # and the quieter `send ./bob` created a second, never-read thread directory.
  valid_name "$to" || die "invalid recipient name: $to"
  valid_name "$from" || die "invalid sender name: $from"
  require_peer "$from"; require_peer "$to"
  [ "$from" != "$to" ] || die "cannot send to yourself"

  local dir tmp seq target
  dir=$(thread_dir "$from" "$to")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.msg.XXXXXX")
  while :; do
    seq=$(( $(max_seq "$dir") + 1 ))
    jq -n --argjson seq "$seq" --arg from "$from" --arg to "$to" \
          --arg type "$type" --arg body "$body" --arg ts "$(now_utc)" --arg ref "$ref" \
      '{seq: $seq, from: $from, to: $to, type: $type, body: $body, ts: $ts}
       + (if $ref == "" then {} else {ref: ($ref | tonumber)} end)' > "$tmp"
    target=$(printf '%s/%05d.json' "$dir" "$seq")
    # Hard-link is atomic and fails if the seq was taken meanwhile — retry.
    # A failure with the target absent is NOT a collision (disk full,
    # permissions, read-only fs): retrying would spin forever, so die.
    if ln "$tmp" "$target" 2>/dev/null; then
      rm -f "$tmp"
      warn_if_unheard "$to" "$from"
      echo "$seq"
      return 0
    fi
    [ -e "$target" ] || { rm -f "$tmp"; die "cannot write message into $dir"; }
  done
}

# Render message JSON as one terse line per message — the delivery format.
# Newlines in bodies are escaped so "one line = one message" always holds.
render_lines() {
  jq -r '"#\(.seq) \(.from) \(.type)\(if .ref then " re#\(.ref)" else "" end): \(.body | gsub("\n"; "\\n"))"'
}

# Consume (or peek at) unread messages across every thread involving me.
# Default output is the terse line format (token-cheap for agents); --json
# emits the full stored objects for scripting.
cmd_poll() {
  local peek=0 json=0 me peer dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --peek) peek=1 ;;
      --json) json=1 ;;
      *) die "usage: bridger poll [--peek] [--json]" ;;
    esac
    shift
  done
  me=$(require_identity)
  # `local` is enough for unread_in_thread to see it: bash scopes dynamically,
  # so a callee reads its caller's locals — and it keeps the name from leaking
  # back into the watcher loop that calls this.
  local top rc failed=0 wedge BRIDGER_WEDGE_FILE
  # One scratch file for the whole call: unread_in_thread reports the seq it
  # stopped at through it (see there for why it cannot be a variable).
  BRIDGER_WEDGE_FILE=$(mktemp "${TMPDIR:-/tmp}/bridger-wedge.XXXXXX")
  trap 'rm -f "$BRIDGER_WEDGE_FILE"' RETURN
  for peer in $(other_peers "$me"); do
    dir=$(thread_dir "$me" "$peer")
    [ -d "$dir" ] || continue
    top=$(max_seq "$dir")
    rc=0
    : > "$BRIDGER_WEDGE_FILE"
    if [ "$json" -eq 1 ]; then
      unread_in_thread "$dir" "$me" "$top" || rc=$?
    else
      unread_in_thread "$dir" "$me" "$top" | render_lines || rc=$?
    fi
    # NEVER advance past a read that failed, and check it explicitly rather than
    # leaning on errexit to abort us. `set -e` is not active inside a command
    # substitution on bash 3.2 — the macOS system bash, and what
    # `#!/usr/bin/env bash` resolves to here — so on the two paths that call this
    # as `out=$(cmd_poll)` (the `wait --follow` watcher, and `ask`) a failed read
    # fell straight through to advance_cursor. That moved the cursor past the
    # message that could not be read AND every message behind it, while the
    # watcher kept beating and the peer kept reading [listening]: silent,
    # permanent loss on the one path that reaches an idle session. Deciding it
    # here makes the guarantee hold in every caller and on every bash.
    # Keep serving the other threads, but remember the failure: a caller that
    # asked to consume must still learn that one thread could not be read, and
    # the CLI's exit status is the only channel for that.
    if [ "$rc" -ne 0 ]; then
      failed=1
      wedge=$(cat "$BRIDGER_WEDGE_FILE" 2>/dev/null || true)
      case "$wedge" in ''|*[!0-9]*) continue ;; esac
      # Advance to just BEFORE the message that could not be read. Refusing to
      # advance at all was the first version of this fix, and it was its own
      # bug: everything before the fault was re-delivered on every 0.5s watcher
      # tick, forever, because the cursor never moved. Stopping one short keeps
      # the guarantee that matters — nothing at or behind the fault is marked
      # read — while delivering what came before it exactly once.
      [ "$peek" -eq 1 ] || advance_cursor "$dir" "$me" "$((wedge - 1))"
      # Say so where the agent will actually see it. stderr does not reach a
      # session — only the watcher's stdout re-invokes one — and a permanent
      # fault (a directory or a root-owned file at NNNNN.json) otherwise stops
      # this thread forever with nothing said on the channel that could act on
      # it. Keyed to the seq on disk so it is one line per fault, not one per
      # tick. --json is exempt: `ask` parses that stream.
      if [ "$peek" -eq 0 ] && [ "$json" -eq 0 ] \
         && [ "$(cat "$dir/wedge-$me" 2>/dev/null || true)" != "$wedge" ]; then
        echo "$wedge" > "$dir/wedge-$me"
        echo "bridger: the thread with $peer is stuck at message $wedge and will deliver nothing past it until that message file in $dir is readable or removed."
      fi
      continue
    fi
    if [ "$peek" -eq 0 ]; then
      [ -f "$dir/wedge-$me" ] && rm -f "$dir/wedge-$me"
      advance_cursor "$dir" "$me" "$top"
    fi
  done
  return "$failed"
}

cmd_wait() {
  local timeout=300 follow=0 me out
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) [ $# -ge 2 ] || die "--timeout needs a value"; timeout="$2"; shift 2 ;;
      --follow)  follow=1; shift ;;
      *) die "usage: bridger wait [--timeout S] [--follow]" ;;
    esac
  done
  me=$(require_identity)
  if [ "$follow" -eq 1 ]; then
    # One terse line per incoming message, forever. Feed this to a watcher.
    # Each cycle also refreshes the heartbeat that marks this peer "listening".
    # Signals must actually exit — a bare cleanup trap would resume the loop.
    # Every exit is logged, signalled or not: an observed exit 144 (128+16,
    # SIGURG on macOS) killed a watcher twice with no trace, and $? plus the
    # command that was running says which of the two paths it took — a signal
    # this shell caught, or `set -e` on a failing command inside the loop.
    # A trap must not change WHETHER the watcher survives a signal, only leave a
    # record: INT/TERM keep their clean stop, SIGURG stays ignored (its default
    # — swallowing it here would be a silent behaviour change), and the fatal
    # ones re-raise themselves so the exit status stays honest.
    local sig
    trap 'watcher_log "$me" "exit=$? cmd=$BASH_COMMAND"; rm -f "$(beat_file "$me")"' EXIT
    trap 'watcher_log "$me" signal=INT; exit 0' INT
    trap 'watcher_log "$me" signal=TERM; exit 0' TERM
    trap 'watcher_log "$me" signal=URG' URG
    for sig in HUP QUIT PIPE USR1 USR2; do
      trap "watcher_log \"\$me\" signal=$sig; trap - $sig; kill -s $sig \$\$" "$sig"
    done
    while :; do
      echo $$ > "$(beat_file "$me")"   # pid + mtime: who is listening, and since when
      # `|| return 1` is load-bearing, not defensive. unread_in_thread refuses to
      # advance the cursor past a message it could not read (EACCES, a revoked
      # mount, EIO) — but it reaches that refusal by dying, and on bash 3.2, which
      # is what /usr/bin/env bash resolves to on stock macOS, errexit is NOT
      # inherited into a command substitution. Without this, cmd_poll did not
      # abort: it fell through to advance_cursor on its own next line and marked
      # the unreadable message AND everything behind it delivered, while this loop
      # kept beating and the peer kept reading [listening]. Silent permanent loss,
      # on the one path that reaches an idle session.
      #
      # Stopping is the safe half of the trade, exactly as it is inside
      # unread_in_thread: the EXIT trap drops the beat, the peer falls back to
      # [queued], and every message is still on disk to be delivered once the
      # fault clears.
      # `|| true`: cmd_poll now returns nonzero when a thread could not be read,
      # and a failing assignment would abort the watcher under set -e. A transient
      # fault must not kill the only thing delivering to this session — loop, keep
      # beating, and retry. The cursor is not advanced, so nothing is lost and it
      # self-heals the moment the file is readable again.
      out=$(cmd_poll) || true || return 1
      [ -n "$out" ] && echo "$out"
      sleep 0.5
    done
  fi
  local deadline=$((SECONDS + timeout))
  while [ "$SECONDS" -lt "$deadline" ]; do
    [ -n "$(cmd_poll --peek)" ] && return 0
    sleep 0.5
  done
  echo "bridger: no message within ${timeout}s" >&2
  return 1
}

cmd_ask() {
  local to="" body="" json=0 me seq line ref
  # A reasoning peer can take minutes to answer; the old 120s default cut
  # max-effort replies off mid-thought. Precedence: --timeout flag wins, else
  # $BRIDGER_ASK_TIMEOUT (export it once for an unattended run), else 300s.
  local timeout="${BRIDGER_ASK_TIMEOUT:-300}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) [ $# -ge 2 ] || die "--timeout needs a value"; timeout="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) if [ -z "$to" ]; then to="$1"; elif [ -z "$body" ]; then body="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$to" ] && [ -n "$body" ] || die "usage: bridger ask <to> <body> [--timeout S] [--json]"
  case "$timeout" in ''|*[!0-9]*) die "timeout must be a whole number of seconds (got: '$timeout')" ;; esac
  # ask correlates ONE reply to one question; fan-out targets can't work here.
  case "$to" in *,*|@all) die "ask takes a single peer (use send for fan-out)" ;; esac
  me=$(require_identity)
  seq=$(cmd_send "$to" ask "$body" --from "$me")
  local deadline=$((SECONDS + timeout)) answer="" sender
  while [ "$SECONDS" -lt "$deadline" ]; do
    answer=""
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      ref=$(jq -r '.ref // empty' <<<"$line")
      sender=$(jq -r '.from // empty' <<<"$line")
      # Match the sender too. Seqs are per-thread, so every thread has a #1 and a
      # ref collision across threads is routine — matching on .ref alone let a
      # THIRD peer's reply satisfy `ask bob`, returned as bob's answer, exit 0,
      # with no way for the caller to tell.
      if [ -z "$answer" ] && [ "$ref" = "$seq" ] && [ "$sender" = "$to" ]; then
        answer="$line"
        continue
      fi
      # Unrelated traffic consumed while waiting — surface it, don't drop it.
      render_lines <<<"$line" >&2
    done <<EOF
$(cmd_poll --json)
EOF
    # Drain the WHOLE batch before returning. `cmd_poll --json` above already
    # consumed it and moved every cursor, so returning the moment the match was
    # seen abandoned every later line in that same batch — never printed, not
    # even to stderr, and unreachable forever. "Peer answers, then adds a note"
    # is the ordinary pattern, and it lost the note every time.
    if [ -n "$answer" ]; then
      if [ "$json" -eq 1 ]; then echo "$answer"; else render_lines <<<"$answer"; fi
      return 0
    fi
    sleep 0.5
  done
  echo "bridger: no reply to #$seq within ${timeout}s" >&2
  return 1
}

cmd_log() {
  local peer="" json=0 me dir f
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *)
        [ -z "$peer" ] || die "usage: bridger log <peer> [--json]"
        peer="$1"; shift ;;
    esac
  done
  [ -n "$peer" ] || die "usage: bridger log <peer> [--json]"
  me=$(require_identity)
  require_peer "$peer"
  dir=$(thread_dir "$me" "$peer")
  [ -d "$dir" ] || { [ "$json" -eq 1 ] || echo "(no messages yet)"; return 0; }
  for f in "$dir"/[0-9]*.json; do
    [ -e "$f" ] || continue
    message_renderable "$f" || continue
    if [ "$json" -eq 1 ]; then
      jq -c . "$f"
    else
      jq -r '"#\(.seq)  \(.ts)  \(.from) -> \(.to)  [\(.type)]\(if .ref then " re #\(.ref)" else "" end)  \(.body)"' "$f"
    fi
  done
}

# Render selected message types of a thread as markdown, deterministically:
# the same thread always produces byte-identical output, so the result can be
# committed as a governance record and regenerated from any checkout. Output
# goes to stdout; the caller decides the file. Default types suit a
# coordinator/worker decision channel; --types all renders everything.
cmd_mirror() {
  local peer="" types="stop,ruling" me dir f t
  while [ $# -gt 0 ]; do
    case "$1" in
      --types) [ $# -ge 2 ] || die "usage: bridger mirror <peer> [--types t1,t2|all]"
               types="$2"; shift 2 ;;
      *) [ -z "$peer" ] && { peer="$1"; shift; } || die "usage: bridger mirror <peer> [--types t1,t2|all]" ;;
    esac
  done
  [ -n "$peer" ] || die "usage: bridger mirror <peer> [--types t1,t2|all]"
  me=$(require_identity)
  require_peer "$peer"
  dir=$(thread_dir "$me" "$peer")

  # Stable header: names in thread (sorted) order, no generation timestamp.
  printf '# Channel log — %s\n\n' "$(basename "$dir" | sed 's/--/ <-> /')"
  printf '<!-- Generated from the message thread by `bridger mirror`. Do not edit; regenerate. -->\n'
  [ -d "$dir" ] || return 0
  for f in "$dir"/[0-9]*.json; do
    [ -e "$f" ] || continue
    message_renderable "$f" || continue
    t=$(jq -r .type "$f")
    case ",$types," in
      *",$t,"* | ",all,") ;;
      *) continue ;;
    esac
    printf '\n## #%s %s — %s\n\n' \
      "$(jq -r .seq "$f")" \
      "$(jq -r '"\(.type)\(if .ref then " re #\(.ref)" else "" end)"' "$f")" \
      "$(jq -r '"\(.ts) \(.from) -> \(.to)"' "$f")"
    jq -r .body "$f"
  done
}

cmd_offline() {
  local me
  me=$(resolve_identity) || exit 0
  rm -f "$(beat_file "$me")"
}

# Serve the read-only web view on loopback. It parses the state files directly
# and never calls back into this script — a consuming `poll` would advance a
# cursor and eat somebody's unread messages.
cmd_monitor() {
  command -v python3 >/dev/null 2>&1 || die "bridger monitor needs python3"
  exec python3 "$ROOT/monitor/server.py" --root "$BRIDGER_ROOT" "$@"
}

cmd_status() {
  local me peer dir top n m
  me=$(resolve_identity) || true
  echo "identity: ${me:-<none — run: bridger register <name>>}"
  [ -n "${me:-}" ] || return 0
  # Both directions. "unread" is what is waiting for you; "unread-by-them" is
  # what you have said that has not landed yet — the number that tells you
  # whether you are being heard or talking to yourself.
  for peer in $(other_peers "$me"); do
    dir=$(thread_dir "$me" "$peer")
    n=0; m=0
    if [ -d "$dir" ]; then
      top=$(max_seq "$dir")
      n=$(unread_in_thread "$dir" "$me" "$top" | grep -c . || true)
      m=$(unread_in_thread "$dir" "$peer" "$top" | grep -c . || true)
    fi
    echo "peer: $peer [$(peer_status "$peer")]  unread: $n  unread-by-them: $m"
  done
}

# Names registered in THIS directory that no live session wears and that this
# session does not already own — the names a restarted session can reclaim.
# Since identity is per session, a session reopened in a directory it once had a
# name in cannot know which name was its own (there may be several); this lists
# them with the count of messages waiting, so the reclaim is an informed choice.
# One line each: "<name>\t<unread>". Skips a peer with a live watcher (someone
# is using that name right now).
cmd_dormant() {
  local sid f name cwd sess
  sid=$(session_id)
  for f in "$BRIDGER_ROOT"/peers/*.json; do
    [ -e "$f" ] || continue
    # The filename is the address — peer and beat files are keyed by it, so a
    # record whose .name drifted would otherwise offer a name nothing can reach.
    name=$(basename "$f" .json)
    cwd=$(jq -er '.cwd // ""' "$f" 2>/dev/null) || continue   # unreadable: not reclaimable
    sess=$(jq -r '.session // ""' "$f")
    case "$PWD" in "$cwd"|"$cwd"/*) ;; *) continue ;; esac
    [ -n "$sid" ] && [ "$sess" = "$sid" ] && continue        # already mine
    [ "$(peer_status "$name")" = "listening" ] && continue   # a live session holds it
    printf '%s\t%s\n' "$name" "$(unread_total "$name")"
  done
}

# Registrations whose directory no longer exists — a deleted worktree, a removed
# checkout. Without this there is no way to remove one: `leave` resolves the peer
# from $PWD, which is impossible once that directory is gone. (A record with no
# readable string cwd is unreachable by both, and stays for a human to `rm` — the
# right trade against deleting a registration on "I cannot read it".)
#
# Dry run unless --force, and it stays that way, because "the directory is gone"
# is NOT proof the peer is dead. A session open in a removed worktree keeps its
# cwd and goes on polling and sending; if it never armed a watcher there is no
# signal here that distinguishes it from a session that closed for good. An
# unmounted volume reads the same. So --force can strand a live peer's mail, and
# that has to be a human's call on the evidence: the dry run prints each
# candidate with how much unread mail it is still holding.
#
# Threads always stay on disk, exactly as `leave` leaves them.
cmd_reap() {
  local force=0 f name found=0 reaped=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) die "usage: bridger reap [--force]" ;;
    esac
  done
  for f in "$BRIDGER_ROOT"/peers/*.json; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .json)
    [ "$(peer_status "$name")" = missing ] || continue
    found=1
    printf '%s\t%s (missing)\t%s unread\n' "$name" "$(peer_cwd "$name")" "$(unread_total "$name")"
    # Re-check immediately before deleting. unread_total walks every message in
    # every thread this peer is in, so the gap since the check above grows with
    # the backlog — seconds for a busy peer. A session that re-registered the
    # name into a real directory inside that window must not be deleted.
    if [ "$force" -eq 1 ] && [ "$(peer_status "$name")" = missing ]; then
      rm -f "$(peer_file "$name")" "$(beat_file "$name")"
      reaped=1
    fi
  done
  if [ "$found" -eq 0 ]; then
    # Not "every directory still exists": a candidate is also excluded by a
    # watcher still running for the name, which is the more useful thing to say
    # to someone who just deleted a worktree and is looking for it here.
    echo "nothing to reap — every registration either still has its directory or still has a watcher process running for it"
  elif [ "$reaped" -eq 1 ]; then
    echo "reaped. Their threads stay on disk as history."
  elif [ "$force" -eq 1 ]; then
    echo "nothing was removed — every candidate stopped being missing between the listing and the delete (re-registered into a real directory, or its watcher came back)."
  else
    echo "note: nothing was removed. Run 'bridger reap --force' to drop these registrations (threads are kept). A session still open in a removed directory cannot be detected here — check the unread counts above before dropping one."
  fi
}

cmd_help() {
  cat <<'EOF'
bridger — message bus between Claude Code sessions (file-based, jq only)

usage:
  bridger peers [--machine|--repo|--dir]
                                      list peers: name, status, directory, branch, summary
  bridger summary <text>               say what this session is working on
  bridger register <name> [dir]        make this (or given) directory addressable, by name
  bridger join                         register with a name derived from the directory
  bridger leave                        stop being addressable here (history kept)
  bridger reap [--force]               list registrations whose directory no longer
                                      exists; --force drops them (threads kept)
  bridger whoami                       print the peer name matching the current directory
  bridger send <to>[,<to>...]|@all <type> <body> [--ref N] [--from <name>]
                                      send a message; prints its seq. A comma list
                                      reaches exactly those peers; @all reaches every
                                      other peer (one copy per pairwise thread)
  bridger poll [--peek] [--json]       print unread messages, one line each:
                                      "#<seq> <from> <type>[ re#<n>]: <body>"; --peek keeps
                                      them unread; --json emits full stored objects
  bridger wait [--timeout S]           block until a message arrives (default 300s)
  bridger wait --follow                stream incoming messages forever, one line each
  bridger ask <to> <body> [--timeout S] [--json]
                                      send an 'ask' and block for the reply (matched by ref);
                                      waits 300s by default, or $BRIDGER_ASK_TIMEOUT
  bridger log <peer> [--json]          full conversation with a peer
  bridger mirror <peer> [--types t1,t2|all]
                                      render selected types as committable markdown
                                      (deterministic; default types: stop,ruling)
  bridger status                       identity, peers, unread counts
  bridger monitor [--port N]           read-only web view of peers, threads and
                                      bus health, in a browser (needs python3)

message types are free-form strings; conventions: chat, ask, answer.
peer status: "listening" (its watcher is running) or "queued" (messages wait on
disk until that session starts again). "missing" is a queued peer whose
registered directory no longer exists AND for which no watcher process is
running — still addressable and still receiving
(it may be a session reading from the removed path), but usually a leftover
registration, which `reap` lists and `reap --force` drops.
OPT-IN by default: only directories you register or join are addressable.
Two sessions in one directory each get their own name — identity follows the
session, not just the directory — so sessions on the same branch can talk.
CLAUDE_BRIDGER_AUTO=1 makes every session join on its own (peers-style mesh);
`bridger leave` keeps a directory out of that mode for good.
data lives under $BRIDGER_ROOT (default ~/.claude/bridger).
EOF
}

# Strip quotes and expand $HOME / $CLAUDE_CONFIG_DIR in a statusLine token, so a
# path pulled from settings.json can be tested on disk. Best-effort: an exotic
# expansion it does not know degrades to a non-existent path (→ "not wired"),
# never to a wrong positive.
_expand_config_path() { # token
  local t="$1"
  t=${t//\"/}; t=${t//\'/}
  t=${t//\$\{HOME\}/$HOME}; t=${t//\$HOME/$HOME}
  t=${t//\$\{CLAUDE_CONFIG_DIR\}/$CLAUDE_CFG_DIR}; t=${t//\$CLAUDE_CONFIG_DIR/$CLAUDE_CFG_DIR}
  printf '%s' "$t"
}

# Is the badge reachable from the ACTIVE statusLine command? True when that
# command names our badge script, iterates the statusline.d drop-in dir (with
# our fragment present), or names a script that — one level down — does either.
# Keys off the current entry point only: a stale chain a file no longer points
# at reads as un-wired. Heuristic but safe — a command it cannot resolve
# degrades to "not wired", at worst one extra re-offer line, never a wrong badge.
statusline_wired() {
  [ -f "$SETTINGS_FILE" ] || return 1
  local cmd tok rt
  cmd=$(jq -r '.statusLine.command // empty' "$SETTINGS_FILE" 2>/dev/null) || return 1
  [ -n "$cmd" ] || return 1
  case "$cmd" in
    *bridger-statusline.sh*) return 0 ;;
    *statusline.d*) [ -f "$STATUSLINE_FRAGMENT" ] && return 0 ;;
  esac
  for tok in $cmd; do
    rt=$(_expand_config_path "$tok")
    [ -f "$rt" ] || continue
    grep -qs 'bridger-statusline\.sh' "$rt" && return 0
    grep -qs 'statusline\.d' "$rt" && [ -f "$STATUSLINE_FRAGMENT" ] && return 0
  done
  return 1
}

# Would a fragment dropped in statusline.d/ render right now? Same resolution as
# statusline_wired, minus the "our fragment is present" clause — this answers
# "is a drop-in dispatcher already the active statusline", i.e. can we wire the
# badge by writing one file and nothing else.
statusline_dispatcher_active() {
  local cmd tok rt
  [ -f "$SETTINGS_FILE" ] || return 1
  cmd=$(jq -r '.statusLine.command // empty' "$SETTINGS_FILE" 2>/dev/null) || return 1
  case "$cmd" in
    '') return 1 ;;
    *statusline.d*) return 0 ;;
  esac
  for tok in $cmd; do
    rt=$(_expand_config_path "$tok")
    [ -f "$rt" ] || continue
    if grep -qs 'statusline\.d' "$rt"; then return 0; fi
  done
  return 1
}

# Install the badge script and the fragment that runs it. The badge is a copy
# outside the plugin dir so it survives plugin updates. Idempotent, and it never
# touches settings.json — wiring that file is the caller's decision.
install_badge_fragment() {
  mkdir -p "$STATUSLINE_D" "$(dirname "$STATUSLINE_BADGE")" || return 1
  cp "$ROOT/hooks/statusline.sh" "$STATUSLINE_BADGE" || return 1
  chmod +x "$STATUSLINE_BADGE" || return 1
  cat > "$STATUSLINE_FRAGMENT" <<EOF || return 1
#!/bin/bash
# statusline.d fragment — bridger peer badge. Needs the Claude Code statusline
# JSON on stdin. Drop-in: delete this file to remove the badge.
exec bash "$STATUSLINE_BADGE"
EOF
  chmod +x "$STATUSLINE_FRAGMENT" 2>/dev/null || true
}

# Self-wire on registration, so the badge lights in THIS session with no
# /bridger:statusline run and no restart. Deliberately narrow: it only drops a
# file into a drop-in dir that is ALREADY the active statusline — reversible,
# invisible to every other badge, and nothing a user has to approve. When there
# is no dispatcher yet, wiring means editing settings.json (and that only takes
# effect next session), which stays an explicit, offered choice — never a side
# effect of `register`. Failure is silent: a badge is cosmetic and must never
# break a registration.
statusline_autowire() {
  if [ -f "$STATUSLINE_FRAGMENT" ] && [ -f "$STATUSLINE_BADGE" ]; then
    # Refresh the stable copy when the plugin ships a newer badge — otherwise an
    # existing install renders the version it was first wired with, forever.
    cmp -s "$ROOT/hooks/statusline.sh" "$STATUSLINE_BADGE" \
      || cp "$ROOT/hooks/statusline.sh" "$STATUSLINE_BADGE" 2>/dev/null || true
    return 0
  fi
  statusline_dispatcher_active || return 0
  install_badge_fragment 2>/dev/null || true
}

# Set settings.json .statusLine to a command, preserving other keys. Backs up
# first and validates the result before replacing — a broken edit never lands.
_set_statusline_command() { # command
  local cmd="$1" tmp="$SETTINGS_FILE.tmp.$$"
  mkdir -p "$(dirname "$SETTINGS_FILE")"
  if [ -f "$SETTINGS_FILE" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.bridger.bak"
    jq --arg c "$cmd" '.statusLine = {type:"command", command:$c}' "$SETTINGS_FILE" > "$tmp" 2>/dev/null \
      || { rm -f "$tmp"; return 1; }
  else
    jq -n --arg c "$cmd" '{statusLine:{type:"command", command:$c}}' > "$tmp" 2>/dev/null \
      || { rm -f "$tmp"; return 1; }
  fi
  jq -e . "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$SETTINGS_FILE"
}

# Wire the badge as a drop-in fragment — never overwriting another tool's
# statusline. The badge is a stable copy (survives plugin updates) run by a
# fragment in statusline.d/. Exit 3 + a NEEDS-CHOICE line means the user already
# runs their own statusline and the caller must decide how to join it.
cmd_statusline() {
  install_badge_fragment || die "could not install the badge script to $STATUSLINE_BADGE"

  # Already reachable (an existing dispatcher picks up the fragment, or a prior
  # chain names the badge) → nothing to wire.
  if statusline_wired; then
    echo "bridger: badge wired — your statusline runs the drop-in fragment."
    return 0
  fi

  local cmd
  cmd=$(jq -r '.statusLine.command // empty' "$SETTINGS_FILE" 2>/dev/null || true)
  if [ -z "$cmd" ]; then
    # No statusline yet: install the generic dispatcher and point at it. Nothing
    # to clobber, and a dispatcher lets the next tool drop a fragment too.
    if ! cp "$ROOT/hooks/statusline-dispatch.sh" "$STATUSLINE_DISPATCH" || ! chmod +x "$STATUSLINE_DISPATCH"; then
      die "could not install the dispatcher to $STATUSLINE_DISPATCH"
    fi
    _set_statusline_command "bash \"$STATUSLINE_DISPATCH\"" || die "could not update $SETTINGS_FILE"
    echo "bridger: installed a drop-in statusline showing the badge. Other tools can add badges by dropping a file in $STATUSLINE_D."
    return 0
  fi

  # A statusline exists and does not reach us — never overwrite it. Hand the
  # decision (join it vs. convert to the drop-in dispatcher) back to the caller.
  printf 'NEEDS-CHOICE\t%s\n' "$cmd"
  return 3
}

# Exit 0 iff the badge is reachable from the active statusLine. The SessionStart
# hook branches on this for the one-time offer and the wired→unwired self-heal.
cmd_statusline_status() {
  statusline_wired && { echo wired; return 0; }
  echo unwired; return 1
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  register) cmd_register "$@" ;;
  autoregister) cmd_autoregister "$@" ;;
  leave)    cmd_leave "$@" ;;
  reap)     cmd_reap "$@" ;;
  join)     cmd_join "$@" ;;
  peers)    cmd_peers "$@" ;;
  summary)  cmd_summary "$@" ;;
  offline)  cmd_offline "$@" ;;
  whoami)   cmd_whoami "$@" ;;
  send)     cmd_send "$@" ;;
  poll)     cmd_poll "$@" ;;
  wait)     cmd_wait "$@" ;;
  ask)      cmd_ask "$@" ;;
  log)      cmd_log "$@" ;;
  mirror)   cmd_mirror "$@" ;;
  status)   cmd_status "$@" ;;
  monitor)  cmd_monitor "$@" ;;
  dormant)  cmd_dormant "$@" ;;
  statusline)        cmd_statusline "$@" ;;
  statusline-status) cmd_statusline_status "$@" ;;
  help|--help|-h) cmd_help ;;
  *) die "unknown command '$cmd' (try: bridger help)" ;;
esac
